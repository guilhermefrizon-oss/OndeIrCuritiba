rules_version = '2';

// ─────────────────────────────────────────────────────────────────────
// Firebase Storage Rules — Day Match Curitiba
//
// O Storage guarda as fotos dos lugares (subidas pelo painel admin via
// "Salvar fotos"). Sem estas regras publicadas, o bucket pode ficar com a
// regra padrão de teste (aberta) — qualquer pessoa poderia subir ou apagar
// arquivos.
//
// Publicar em: Firebase Console → Storage → Rules → colar → Publicar.
//
// Princípio: leitura pública (o app exibe as fotos sem login);
// escrita/exclusão só admin (mesma lista /admins do Firestore).
// ─────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Fotos são públicas para exibição no app e no site.
      allow read: if true;

      // Escrever/apagar: só quem está na coleção /admins do Firestore
      // (mesmo critério das regras do banco). Limite de 5 MB por arquivo
      // e só imagens.
      allow write: if request.auth != null
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email))
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
  }
}
