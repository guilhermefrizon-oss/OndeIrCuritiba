{
  "appId": "com.daymatch.curitiba",
  "appName": "Day Match",
  "webDir": "www",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#F6F6F4",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com", "apple.com"]
    }
  }
}
